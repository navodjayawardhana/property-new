# Base URL of the Laravel API, including the /api suffix.
#
# IMPORTANT: this is a NEXT_PUBLIC_* variable, so it is baked in at BUILD time.
# If it is not set when the production build runs, src/lib/api.ts silently falls
# back to http://localhost:8000/api — every listing, agent and news request then
# fails in production, and the sitemap and district pages render with no data.
# Set it in the deployment environment before `npm run build`.
NEXT_PUBLIC_API_URL=https://api.greenbricks.net/api
